<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MovieActivity">

    <FrameLayout
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="@+id/scrollView2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="5dp"
        android:background="@color/loading_white"
        android:visibility="gone"
        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="15dp"
            android:orientation="vertical"
            android:layout_gravity="center">


            <ProgressBar
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Загружаю данные..."
                android:layout_gravity="center"
                android:textSize="10pt"/>

        </LinearLayout>

    </FrameLayout>


    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:paddingHorizontal="40dp"
            android:paddingBottom="40dp">


            <LinearLayout
                android:id="@+id/movie_name_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="5dp"
                app:layout_constraintTop_toBottomOf="@+id/movie_date_view">

                <TextView
                    android:id="@+id/movie_name_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/name_label"
                    android:textAlignment="textStart"
                    android:textColor="@color/gray"
                    android:textSize="8pt" />

                <Spinner
                    android:id="@+id/movie_name_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_hall_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal"
                android:paddingVertical="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/movie_place_view">

                <TextView
                    android:id="@+id/movie_hall_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/hall_label"
                    android:textAlignment="textStart"
                    android:textColor="@color/gray"
                    android:textSize="8pt" />

                <Spinner
                    android:id="@+id/movie_hall_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_date_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="5dp"
                app:layout_constraintStart_toStartOf="@+id/movie_hall_view"
                app:layout_constraintTop_toBottomOf="@+id/title">

                <TextView
                    android:id="@+id/movie_date_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"

                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/date_label"
                    android:textColor="@color/black"
                    android:textSize="8pt" />

                <Spinner
                    android:id="@+id/movie_date_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_time_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingVertical="5dp"
                app:layout_constraintStart_toStartOf="@+id/movie_hall_view"
                app:layout_constraintTop_toBottomOf="@+id/movie_name_view">

                <TextView
                    android:id="@+id/movie_time_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"

                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/time_label"
                    android:textColor="@color/gray"
                    android:textSize="8pt" />

                <Spinner
                    android:id="@+id/movie_time_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_row_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:paddingVertical="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/movie_time_view">

                <TextView
                    android:id="@+id/movie_row_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/row_label"
                    android:textAlignment="textStart"
                    android:textColor="@color/gray"
                    android:textSize="8pt" />

                <Spinner
                    android:id="@+id/movie_row_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ems="10"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textAlignment="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/movie_place_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:paddingVertical="5dp"
                android:layout_marginTop="20dp"

                android:gravity="center_vertical"
                android:orientation="horizontal"

                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/movie_row_view">

                <TextView
                    android:id="@+id/movie_place_label"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"

                    android:layout_marginEnd="5dp"
                    android:textAlignment="textStart"

                    android:fontFamily="@font/unageo_bold"
                    android:text="@string/place_label"
                    android:textColor="@color/gray"
                    android:textSize="8pt" />

                <EditText
                    android:id="@+id/movie_place_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="0123456789,-"
                    android:ems="10"
                    android:hint="@string/default_hint"
                    android:inputType="number"
                    android:minHeight="48dp"
                    android:textAlignment="center"
                    android:textSize="10pt" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/done_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:layout_marginTop="40dp"
                android:background="@drawable/buttons_done_btn_main_background"

                android:gravity="center"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/clear_btn" >


                <ImageView
                    android:id="@+id/imageView4"
                    android:layout_width="60dp"
                    android:layout_height="60dp"

                    android:background="@drawable/buttons_done_btn_image_background"
                    android:padding="4dp"
                    android:layout_marginEnd="25dp"

                    app:srcCompat="@drawable/icons_done_btn_icon" />

                <TextView
                    android:id="@+id/textView6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"

                    android:textColor="@color/white"
                    android:fontFamily="@font/hikasami_bold"
                    android:textSize="10pt"

                    android:text="@string/submit_btn" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/clear_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"

                android:layout_marginTop="40dp"
                android:background="@drawable/buttons_clear_btn_main_background"

                android:gravity="center"

                app:layout_constraintStart_toStartOf="@+id/done_btn"
                app:layout_constraintTop_toBottomOf="@+id/movie_hall_view" >

                <ImageView
                    android:id="@+id/imageView3"
                    android:layout_width="60dp"
                    android:layout_height="60dp"

                    android:background="@drawable/buttons_clear_btn_image_background"
                    android:padding="4dp"
                    android:layout_marginEnd="25dp"

                    app:srcCompat="@drawable/icons_clear_btn_icon" />

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="textStart"

                    android:textColor="@color/white"
                    android:fontFamily="@font/hikasami_bold"
                    android:textSize="10pt"

                    android:text="@string/clear_btn" />


            </LinearLayout>

            <Button
                android:id="@+id/history_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="160dp"

                android:paddingVertical="15dp"
                android:background="@drawable/buttons_done_btn_image_background"
                android:fontFamily="sans-serif-condensed-medium"

                android:text="@string/history_btn"

                android:textColor="@color/white"

                android:textSize="8pt"
                app:layout_constraintEnd_toEndOf="@+id/done_btn"
                app:layout_constraintTop_toBottomOf="@+id/done_btn" />


            <ImageView
                android:id="@+id/back_img_btn"
                android:layout_width="60dp"
                android:layout_height="60dp"

                android:layout_marginTop="32dp"

                app:layout_constraintHorizontal_bias="0"

                android:padding="4dp"
                app:layout_constraintEnd_toStartOf="@+id/title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/icons_back_btn_icon" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="32dp"

                android:fontFamily="@font/podarok"

                android:text="@string/movie_page_title"
                android:textAlignment="center"
                android:textColor="@color/black"

                android:textSize="18pt"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>