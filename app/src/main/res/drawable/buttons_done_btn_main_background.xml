<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Состояние нажатия (вдавленный эффект) -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#CC4CAF50"/>
                    <corners
                        android:topLeftRadius="25dp"
                        android:bottomLeftRadius="25dp"
                        android:radius="15dp"/>
                    <stroke android:color="#CC2E7D32" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычное состояние -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4CAF50"/>
                    <corners android:radius="15dp"/>
                    <stroke android:color="#2E7D32" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>