<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Состояние нажатия (вдавленный эффект) -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#CC5C6BC0"/>
                    <corners
                        android:radius="15dp"/>
                    <stroke android:color="#CC3949AB" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычное состояние -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#5C6BC0"/>
                    <corners
                        android:radius="15dp"/>
                    <stroke android:color="#3949AB" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>