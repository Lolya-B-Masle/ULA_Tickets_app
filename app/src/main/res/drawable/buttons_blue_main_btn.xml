<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Состояние нажатия (вдавленный эффект) -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Смещённая тень (уменьшаем смещение при нажатии) -->
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#40000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>

            <!-- Основная кнопка (темнее при нажатии) -->
            <item android:bottom="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#E6DEDD" /> <!-- Темнее на 10% -->
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="8px"
                        android:color="@color/white"/>
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Обычное состояние -->
    <item>
        <layer-list>
            <!-- Тень (левый нижний угол) -->
            <item
                android:left="4dp"
                android:top="4dp"
                android:right="0dp"
                android:bottom="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="#60000000" />
                    <corners android:radius="12dp" />
                </shape>
            </item>

            <!-- Основная кнопка -->
            <item android:bottom="2dp" android:right="2dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FF5252"
                        android:endColor="#FF1744"
                        android:angle="270"/>
                    <corners android:radius="12dp" />
                    <stroke
                        android:width="8px"
                        android:color="@color/white"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>