<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#CCBA68C8"/>
                    <corners android:radius="15dp"/>
                    <stroke android:color="#CCAB47BC" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- Default state -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#BA68C8"/>
                    <corners android:radius="15dp"/>
                    <stroke android:color="#AB47BC" android:width="4px"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>